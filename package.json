{
  "name": "bambooshift",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs scripts/dev.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:operations": "vite --config operations/vite.config.ts",
    "dev:server": "node scripts/run.mjs scripts/start-backend.mjs",
    "build": "npm run backend:build && npm run build:web",
    "build:web": "tsc --noEmit && vite build --config web/vite.config.ts && vite build --config operations/vite.config.ts",
    "build:operations": "tsc --noEmit && vite build --config operations/vite.config.ts",
    "build:workers": "node scripts/run.mjs scripts/build-workers.mjs",
    "backend:package": "node scripts/run.mjs scripts/package-backend.mjs",
    "backend:build": "node scripts/run.mjs scripts/rust-build.mjs",
    "backend:test": "node scripts/run.mjs scripts/rust-test.mjs",
    "configure:local": "node scripts/run.mjs scripts/configure-local.mjs",
    "start": "node scripts/run.mjs scripts/start-backend.mjs",
    "avatars": "node scripts/run.mjs scripts/export-avatars.ts",
    "test": "npm run backend:test && npm run test:web && npm run test:runtime && npm run client:test",
    "test:web": "node scripts/run.mjs scripts/test-suite.mjs web",
    "computer": "node scripts/run.mjs scripts/computer-worker.ts",
    "computer:worker": "node scripts/run.mjs scripts/computer-worker.ts",
    "computer:pair": "node scripts/run.mjs scripts/pair-computer.mjs",
    "computer:services": "node scripts/run.mjs scripts/computer-services.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:check": "node scripts/check-desktop.mjs",
    "client:dev": "node scripts/run.mjs scripts/run-client.mjs",
    "client:package": "node scripts/run.mjs scripts/package-client.mjs",
    "client:test": "node scripts/run.mjs --test desktop/*.test.cjs",
    "format": "prettier --write web operations shared scripts server/workers desktop",
    "check:source": "node scripts/run.mjs scripts/source/check-source-policy.mjs",
    "test:pi-worker": "node scripts/run.mjs --test server/workers/pi-worker/*.test.ts",
    "test:source-policy": "node scripts/run.mjs --test scripts/source/source-policy.test.mjs",
    "check:privacy": "node scripts/run.mjs scripts/source/check-private-config.mjs",
    "source:export": "node scripts/run.mjs scripts/source/export-source.mjs",
    "test:runtime": "node scripts/run.mjs scripts/test-suite.mjs runtime",
    "test:browser": "node scripts/run.mjs scripts/test-suite.mjs browser"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@sinclair/typebox": "^0.34.41",
    "express": "^5.1.0",
    "i18next": "^26.7.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.1.13",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "^0.35.5",
    "undici": "8.12.2",
    "unified": "11.0.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.2.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "undici": "8.12.2",
    "glob": "14.0.3"
  },
  "license": "MIT"
}
