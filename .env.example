# Use Node.js 22.19+ and Rust 1.85+. These variables configure local launchers.
PORT=3001
OPENBOT_DATA_DIR=./data
# OPENBOT_SERVER_CONFIG=/ABSOLUTE/PATH/TO/server.private.json
# OPENBOT_NODE=/ABSOLUTE/PATH/TO/node
# Run npm run configure:local once, then npm run dev -- --init-operator.
# Configure models through workspace Settings; model keys are private files.
# Configure product/operations HTTPS origins in the private server JSON.
# A dedicated computer worker has its own explicitly selected environment.
# OPENBOT_WORKER_TOKEN=replace-with-a-long-random-token
# OPENBOT_WORKER_PORT=3100
# OPENBOT_BROWSER_HEADLESS=false
