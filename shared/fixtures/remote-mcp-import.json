{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "only names and canonical addresses survive",
      "input": {
        "mcpServers": {
          " Docs ": {
            "url": "https://DOCS.example.com:443/mcp",
            "headers": {
              "Authorization": "SYNTHETIC_HEADER"
            },
            "token": "SYNTHETIC_TOKEN",
            "env": {
              "KEY": "SYNTHETIC_ENV"
            }
          },
          "local": {
            "url": "https://local.example.com/mcp",
            "command": "synthetic-command"
          },
          "arguments": {
            "url": "https://arguments.example.com/mcp",
            "args": []
          },
          "legacy": {
            "url": "https://old.example.com/sse",
            "type": "sse"
          }
        },
        "servers": {
          "second": {
            "url": "https://other.example.com/mcp",
            "type": "http",
            "transport": "streamable-http"
          },
          "duplicate": {
            "url": "https://docs.example.com/mcp"
          },
          "bad-type": {
            "url": "https://bad.example.com/mcp",
            "type": null
          }
        },
        "inputs": [
          {
            "id": "synthetic-key",
            "type": "promptString"
          }
        ]
      },
      "expected": {
        "ok": true,
        "candidates": [
          {
            "name": "Docs",
            "url": "https://docs.example.com/mcp"
          },
          {
            "name": "second",
            "url": "https://other.example.com/mcp"
          }
        ],
        "skipped": 5
      },
      "projectionExpected": {
        "ok": true,
        "candidates": [
          {
            "name": "Docs",
            "url": "https://DOCS.example.com:443/mcp"
          },
          {
            "name": "second",
            "url": "https://other.example.com/mcp"
          },
          {
            "name": "duplicate",
            "url": "https://docs.example.com/mcp"
          }
        ],
        "skipped": 4
      }
    },
    {
      "name": "numeric object keys have JavaScript enumeration order",
      "source": "{\"servers\":{\"10\":{\"url\":\"https://example.com/shared\"},\"2\":{\"url\":\"https://example.com/shared\"},\"first\":{\"url\":\"https://example.com/other\"}}}",
      "expected": {
        "ok": true,
        "candidates": [
          {
            "name": "2",
            "url": "https://example.com/shared"
          },
          {
            "name": "first",
            "url": "https://example.com/other"
          }
        ],
        "skipped": 1
      },
      "projectionExpected": {
        "ok": true,
        "candidates": [
          {
            "name": "2",
            "url": "https://example.com/shared"
          },
          {
            "name": "first",
            "url": "https://example.com/other"
          }
        ],
        "skipped": 1
      }
    },
    {
      "name": "malformed JSON",
      "source": "invalid SYNTHETIC_SECRET",
      "expected": {
        "ok": false,
        "reason": "json"
      },
      "projectionExpected": {
        "ok": false,
        "reason": "json"
      }
    },
    {
      "name": "null root",
      "input": null,
      "expected": {
